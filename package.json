{
  "name": "quizzy",
  "description": "A single or multiplayer (local) quiz game. Quizzy 🥴 — sounds like queasy.",
  "version": "0.1.0",
  "author": "Christopher Murphy (christopherianmurphy@gmail.com)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config config/vite.config.ts",
    "build": "vue-tsc -b config && vite build --config config/vite.config.ts",
    "preview": "vite preview --config config/vite.config.ts",
    "validate:questions": "node scripts/validate-questions.mjs",
    "test": "vitest run --config config/vite.config.ts"
  },
  "dependencies": {
    "pinia": "^3.0.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "jsdom": "^26.1.0",
    "sass": "^1.86.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.0.0",
    "vue-tsc": "^3.0.0",
    "workbox-precaching": "^7.4.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.6.0": true
  }
}
